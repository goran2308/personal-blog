---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import TopLink from "../components/TopLink.astro";
import { SEO } from "astro-seo";
import PTscript from "../components/PTscript.astro";

interface Props {
  pageTitle: string;
  h1Title: string;
}

const { pageTitle, h1Title } = Astro.props;
const myName = "Goran Solev";
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <PTscript />
  </head>

  <body class="mx-auto flex flex-col h-screen px-8">
    <TopLink
      class="mt-24"
      url="/"
      icon="carbon:arrow-left"
      text="goransolev.com"
    />
    <main class="grow">
      <h1><span>{h1Title}</span></h1>
      <div>
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
