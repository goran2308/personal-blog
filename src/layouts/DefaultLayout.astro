---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { h1Title } = Astro.props;
---

<html lang="en">
  <Head pageTitle="Home" />
  <body class="mx-auto flex flex-col h-screen">
    <main class="grow mt-24">
      <h1><span>{h1Title}</span></h1>
      <div class="leading-[1.75rem]">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
