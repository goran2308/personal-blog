---
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"
import "../styles/global.css"

const myName = "Goran Solev"
const { frontmatter } = Astro.props
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={frontmatter.title + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="mx-auto flex flex-col h-screen px-8">
    <p class="mt-24">
      <a href="/all">&larr;All posts</a>
    </p>
    <h1><span>{frontmatter.title}</span></h1>
    <p class="mb-6"><em>{frontmatter.description}</em></p>

    <main>
      {
        frontmatter.tags.map((tag) => (
          <p>
            {" "}
            Category:
            <a href={`/tags/${tag}`}>
              <code>{tag}</code>
            </a>
          </p>
        ))
      }

      <p>Published on: {frontmatter.pubDate}</p>
      <p class="mb-12">Written by {frontmatter.author}</p>

      <slot />
    </main>
    <Footer />
  </body>
</html>
