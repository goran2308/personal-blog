---
import Footer from "../components/Footer.astro"
import TopLink from "../components/TopLink.astro"
import { SEO } from "astro-seo"
import "../styles/global.css"

const myName = "Goran Solev"
const { frontmatter } = Astro.props
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={frontmatter.title + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="mx-auto flex flex-col h-screen px-8">
    <TopLink url="/all" arrow="←" text="All posts" />
    <h1><span>{frontmatter.title}</span></h1>

    <main>
      {
        frontmatter.tags.map((tag) => (
          <p>
            Tag:
            <a href={`/tags/${tag}`}>{tag}</a>
          </p>
        ))
      }

      <p class="mb-12">Published on: {frontmatter.pubDate}</p>

      <slot />
    </main>
    <Footer />
  </body>
</html>
