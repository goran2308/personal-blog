---
import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import TopLink from "../components/TopLink.astro";
import { SEO } from "astro-seo";
import Gtag2 from "../components/gtag2.astro";
import "../styles/global.css";

import { formatDate } from "../js/utils";

const myName = "Goran Solev";
const { frontmatter } = Astro.props;
const topLinkClasses = ["pt-24", "flex", "underline"];
const topLinkClass = [...topLinkClasses];
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={frontmatter.title + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <script
      defer
      src="http://192.168.0.13:3003/script.js"
      data-website-id="97495836-129a-430e-af03-6d2ef6cb3b94"></script>
  </head>

  <body class="mx-auto flex flex-col h-screen px-8">
    <Gtag2 />
    <TopLink class="mt-24" url="/all" arrow="←" text="All posts" />
    <h1><span>{frontmatter.title}</span></h1>

    <main>
      {
        frontmatter.tags.map((tag) => (
          <p>
            Tag:
            <a href={`/tags/${tag}`}>{tag}</a>
          </p>
        ))
      }

      <p class="mb-12">Published on: {formatDate(frontmatter.pubDate)}</p>

      <slot />
    </main>

    <Footer />

    <BackToTop />
  </body>
</html>
