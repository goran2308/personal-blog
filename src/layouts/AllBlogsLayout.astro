---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="max-w-2xl mx-auto flex flex-col h-screen px-8">
    <p class="mb-2 mt-24">
      <a href="/">&larr; goransolev.com</a>
    </p>
    <main class="grow">
      <h1 class="font-medium leading-tight text-5xl mb-6">{h1Title}</h1>

      <slot />
      <!-- the content is injected here -->
    </main>
    <Footer />
  </body>
</html>
