---
import Footer from "../components/Footer.astro"
import TopLink from "../components/TopLink.astro"
import { SEO } from "astro-seo"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="mx-auto flex flex-col h-screen px-8">
    <TopLink url="/" arrow="←" text="goransolev.com" />
    <main class="grow">
      <h1 class="font-medium"><span>{h1Title}</span></h1>
      <slot />
    </main>
    <Footer />
  </body>
</html>
