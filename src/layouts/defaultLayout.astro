---
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"
import "../styles/global.css"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="mx-auto flex flex-col h-screen px-8">
    <main class="grow mt-24">
      <h1><span>{h1Title}</span></h1>
      <div class="leading-[1.75rem]">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
