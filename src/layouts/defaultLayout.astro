---
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>
  <body class="max-w-2xl mx-auto flex flex-col h-screen">
    <Header />
    <main class="grow">
      <h1 class="text-2xl leading-loose">{h1Title}</h1>
      <article class="leading-[1.75rem]">
        <slot />
        <!-- the content is injected here -->
      </article>
    </main>
    <Footer />
    <script>
      import "../scripts/menu"
    </script>
  </body>
</html>
