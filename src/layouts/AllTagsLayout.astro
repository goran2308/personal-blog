---
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"
import "../styles/global.css"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
  </head>

  <body class="mx-auto flex flex-col h-screen px-8">
    <p class="mt-24">
      <a href="/">&larr; goransolev.com</a>
    </p>
    <main class="grow">
      <h1><h1>{h1Title}</h1></h1>
      <div>
        <slot />
      </div>

      <Footer />
    </main>
  </body>
</html>
