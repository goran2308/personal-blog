---
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import TopLink from "../components/TopLink.astro";
import "../styles/global.css";

const { h1Title } = Astro.props;
---

<html lang="en">
  <Head />
  <body class="mx-auto flex flex-col h-screen px-8">
    <TopLink class="mt-24" url="/" arrow="←" text="goransolev.com" />

    <main class="grow">
      <h1><h1>{h1Title}</h1></h1>
      <div>
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
