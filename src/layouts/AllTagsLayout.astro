---
import Head from "../components/Head.astro"
import Footer from "../components/Footer.astro"
import "../styles/global.css"

const { h1Title } = Astro.props
---

<html lang="en">
  <Head />

  <body class="mx-auto flex flex-col h-screen px-8">
    <p class="mt-24">
      <a href="/">&larr; goransolev.com</a>
    </p>

    <main class="grow">
      <h1><h1>{h1Title}</h1></h1>
      <div>
        <slot />
      </div>
    </main>

    <Footer />
  </body>
</html>
