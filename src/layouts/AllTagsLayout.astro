---
import Footer from "../components/Footer.astro"
import { SEO } from "astro-seo"
import "../styles/global.css"

const { pageTitle, h1Title } = Astro.props
const myName = "Goran Solev"
---

<html lang="en">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO
      title={pageTitle + " | " + myName}
      description="Goran Solev | Personal website and blog"
      charset="utf-8"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/icons/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/icons/favicon-16x16.png"
    />
    <link rel="manifest" href="/site.webmanifest" />
  </head>

  <body class="mx-auto flex flex-col h-screen px-8">
    <p class="mt-24">
      <a href="/">&larr; goransolev.com</a>
    </p>
    <main class="grow">
      <h1><h1>{h1Title}</h1></h1>
      <div>
        <slot />
      </div>

      <Footer />
    </main>
  </body>
</html>
