---
import { formatDate } from "../js/utils"

const { url, title, date, tag } = Astro.props
---

<tr>
  <td class="w-32"
    ><code class="text-sm whitespace-normal p-1">{formatDate(date)}</code><a
      href={`/tags/${tag}`}
      class="text-sm whitespace-nowrap overflow-hidden sm:hidden block">{tag}</a
    ></td
  >
  <td class="text-sm whitespace-normal px-4 hidden sm:table-cell"
    ><a href={`/tags/${tag}`}>{tag}</a></td
  >
  <td class="pl-2 py-1.5"><a href={url} class="break-words">{title}</a></td>
</tr>
