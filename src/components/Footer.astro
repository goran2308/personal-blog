---
import Social from "./Social.astro"
---

<footer class="py-10">
  <div>
    <div class="flex flex-row justify-center">
      <!-- Props: platform, username, icon -->
      <Social
        platform="github"
        username="goran2308"
        icon="iconoir:github"
        ariaLabel="Go to my GitHub profile"
      />
      <Social
        platform="linkedin"
        username="/in/goran-solev-5a5bb487"
        icon="uit:linkedin-alt"
        ariaLabel="Go to my LinkedIn profile"
      />
    </div>
    <small class="block text-center mt-2"
      >Goran Solev &#169; {new Date().getFullYear().toString()}</small
    >
  </div>
</footer>
