---
import { Icon } from "astro-icon"
---

<button id="backtop"><Icon name="carbon:arrow-up" class="w-[30px]" /></button>

<style>
  #backtop {
    position: fixed;
    bottom: 10%;
    right: 15%;
    border: 2px solid #0e273c;
    padding: 10px;
    border-radius: 5px;
    z-index: 999;

    opacity: 0;
    visibility: hidden;

    transition: visibility 0.3s, opacity 0.3s;
  }

  #backtop.show {
    opacity: 1;
    visibility: visible;
  }

  @media screen and (max-width: 2560px) {
    #backtop {
      right: 25%;
    }
  }

  @media screen and (min-width: 1535px) and (max-width: 1920px) {
    #backtop {
      right: 10%;
    }
  }

  @media screen and (min-width: 1280px) and (max-width: 1536px) {
    #backtop {
      right: 7%;
    }
  }

  @media screen and (min-width: 0px) and (max-width: 1024px) {
    #backtop {
      display: none;
    }
  }
</style>

<script>
  const bttButton = document.querySelector("#backtop")

  const toTop = () =>
    window.scroll({
      top: 0,
      left: 0,
      behavior: "smooth",
    })

  bttButton.addEventListener("click", toTop)

  const toggleTop = () => {
    if (window.scrollY >= 100) {
      bttButton.classList.add("show")
    } else {
      bttButton.classList.remove("show")
    }
  }

  window.addEventListener("scroll", toggleTop)
  window.addEventListener("resize", toggleTop)
</script>
