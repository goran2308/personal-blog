---
import { formatBlogPosts } from "../js/utils";

const allPosts = await import.meta.glob("../pages/posts/*.md");
const formattedPosts = await formatBlogPosts(allPosts);
const tags = [
  ...new Set(formattedPosts.map((post) => post.frontmatter.tags).flat()),
];
---

<ul class="flex flex-row flex-wrap">
  {
    tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag}`}
          class="bg-[#0e273c] text-white mr-2 no-underline px-3 py-1"
        >
          {tag}
        </a>
      </li>
    ))
  }
</ul>
