---
import AllLayout from "../layouts/AllBlogsLayout.astro"
import BlogPost from "../components/BlogPost.astro"
import TagsList from "../components/TagsList.astro"

import { formatDate, formatBlogPosts } from "../js/utils"

const allPosts = await Astro.glob("../pages/posts/*.md")

const formattedPosts = formatBlogPosts(allPosts)
---

<AllLayout pageTitle="All Posts" h1Title="All the posts:">
  <h2 class="my-8 leading-tight">Explore by tags:</h2>
  <TagsList />
  <h2 class="my-8 leading-tight">Explore by date:</h2>
  <table>
    <tbody>
      {
        formattedPosts.map((post) => (
          <BlogPost
            url={post.url}
            title={post.frontmatter.title}
            date={formatDate(post.frontmatter.pubDate)}
            tag={post.frontmatter.tags}
          />
        ))
      }
    </tbody>
  </table>
</AllLayout>
