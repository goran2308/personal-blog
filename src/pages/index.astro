---
import DefaultLayout from "../layouts/defaultLayout.astro"
import BlogPost from "../components/BlogPost.astro"
import BottomLink from "../components/BottomLink.astro"

import { formatDate, formatBlogPosts } from "../js/utils"

const allPosts = await Astro.glob("../pages/posts/*.md")

const formattedPosts = formatBlogPosts(allPosts, {
  limit: 5,
})
---

<DefaultLayout h1Title="Hi there!">
  <p>
    I am Goran, the writer on this blog. I hope you will find the solution for
    your coding problems and learn new stuff while reading my blog posts.
  </p>
  <br />
  <p>I publish a new post every two weeks. Stay tuned and follow my blog!</p>

  <div class="mt-[70px]">
    <h2 class="font-medium leading-tight">Latest:</h2>
    <table>
      <tbody>
        {
          formattedPosts.map((post) => (
            <BlogPost
              url={post.url}
              title={post.frontmatter.title}
              date={formatDate(post.frontmatter.pubDate)}
              tag={post.frontmatter.tags}
            />
          ))
        }
      </tbody>
    </table>
  </div>
  <BottomLink url="/all" arrow="→" text="All posts" />
</DefaultLayout>
