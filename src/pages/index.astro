---
import DefaultLayout from "../layouts/defaultLayout.astro"
import BlogPost from "../components/BlogPost.astro"

const allPosts = await Astro.glob("../pages/posts/*.md")
---

<DefaultLayout pageTitle="Home" h1Title="Hi there!">
  <p>
    I am Goran, the owner and writer on this blog. I hope you will find the
    solution for your coding problems and learn new stuff while spending your
    time here and reading my blog posts.
  </p>
  <br />
  <p>I publish a new post every two weeks. Stay updated and follow my blog!</p>

  <div class="mt-[70px]">
    <h3 class="font-medium leading-tight text-3xl mb-6">Latest:</h3>
    <table>
      <tbody>
        {
          allPosts
            .sort(
              (a, b) =>
                Date.parse(b.frontmatter.pubDate) -
                Date.parse(a.frontmatter.pubDate)
            )
            .map((post) => (
              <BlogPost
                url={post.url}
                title={post.frontmatter.title}
                date={post.frontmatter.pubDate}
                tag={post.frontmatter.tags}
              />
            ))
            .slice(0, 5)
        }
      </tbody>
    </table>
  </div>
  <p class="mt-6">
    <a href="/all">All posts &rarr;</a>
  </p>
</DefaultLayout>
