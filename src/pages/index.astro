---
import DefaultLayout from "../layouts/DefaultLayout.astro";
import BottomLink from "../components/BottomLink.astro";

import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);

const latestPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<DefaultLayout h1Title="Hi there!">
  <p>
    My name is Goran, the writer on this blog. This is just my personal journal
    where I keep tutorials, recipes and other instructions that I need.
  </p>
  <br />
  <p>I made it public because I believe that sharing is caring.</p>
  <br />
  <p>I publish a new post whenever I can. Stay tuned and follow my blog!</p>

  <div class="mt-[70px]">
    <h2 class="font-medium leading-tight">Latest:</h2>

    {
      latestPosts.length === 0 ? (
        <p class="mt-6 text-gray-600 dark:text-gray-400">
          No posts found yet. Make sure src/content/posts/ contains .md files.
        </p>
      ) : (
        <table class="mt-4 w-full">
          <tbody>
            {latestPosts.map((post) => (
              <tr>
                <td class="w-32">
                  <code class="text-sm whitespace-normal p-1">
                    {post.data.date.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </code>
                </td>

                <td class="text-sm whitespace-normal px-4 hidden sm:table-cell">
                  <a href={`/tags/${post.data.tags?.[0]}`}>
                    {post.data.tags?.join(", ") || ""}
                  </a>
                </td>

                <td class="py-1.5 pl-2">
                  <a href={`/posts/${post.id}`} class="hover:underline">
                    {post.data.title}
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
  <BottomLink url="/all" text="All posts" />
</DefaultLayout>
